---
import SiteLayout from '../shared/layouts/SiteLayout.astro';
import GiscusComments from '../shared/components/GiscusComments.astro';

const configuredDiscussionNumber = Number(import.meta.env.PUBLIC_GUESTBOOK_DISCUSSION_NUMBER?.trim());
const discussionNumber = Number.isSafeInteger(configuredDiscussionNumber) && configuredDiscussionNumber > 0
  ? configuredDiscussionNumber
  : undefined;
const guestbookCategory = import.meta.env.PUBLIC_GISCUS_GUESTBOOK_CATEGORY?.trim();
const guestbookCategoryId = import.meta.env.PUBLIC_GISCUS_GUESTBOOK_CATEGORY_ID?.trim();
---

<SiteLayout title="방명록 — itsdangerous" description="itsdangerous 방명록" canonicalPath="/guestbook/">
  <main class="shell simple-page">
    <p class="eyebrow">Guestbook</p>
    <h1>방명록</h1>
    <p>방명록은 GitHub Discussions로 운영합니다.</p>
    <GiscusComments
      mapping="specific"
      discussionNumber={discussionNumber}
      category={guestbookCategory}
      categoryId={guestbookCategoryId}
    />
  </main>
</SiteLayout>
