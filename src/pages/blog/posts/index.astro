---
import { getCollection } from 'astro:content';
import BlogLayout from '../../../domains/blog/layouts/BlogLayout.astro';
import PostCard from '../../../domains/blog/components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const pageSize = 10;
const posts = allPosts.slice(0, pageSize);
const totalPages = Math.ceil(allPosts.length / pageSize);
---

<BlogLayout title="글 목록 — itsdangerous" description="itsdangerous의 모든 기록" canonicalPath="/blog/posts/">
  <main class="shell archive-page">
    <header class="archive-page__header">
      <p class="eyebrow">Archive</p>
      <h1>모든 글</h1>
      <p>{posts.length}개의 기록을 시간순으로 모았습니다.</p>
    </header>
    <ol class="post-list">
      {posts.map((post, index) => <PostCard post={post} index={index} />)}
    </ol>
    <Pagination currentPage={1} totalPages={totalPages} basePath="/blog/posts" />
  </main>
</BlogLayout>
