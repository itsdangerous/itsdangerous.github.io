---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Portfolio — itsdangerous" description="itsdangerous의 작업을 모으는 공간" canonicalPath="/portfolio/">
  <main class="shell">
    <section class="intro" aria-labelledby="portfolio-title">
      <p class="eyebrow">Portfolio</p>
      <h1 id="portfolio-title">작업을 정리하고 있습니다.</h1>
      <p class="intro__description">완성한 작업과 그 과정에서 내린 선택들을 이곳에 기록합니다.</p>
    </section>
  </main>
</BaseLayout>
