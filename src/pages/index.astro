---
import SplashLayout from '../domains/main/layouts/SplashLayout.astro';
import '../domains/main/styles/splash.css';
---

<SplashLayout title="itsdangerous" description="기록과 작업, 취향과 놀이를 보관하는 한 권의 개인 장서">
  <main class="book-splash">
    <aside class="book-splash__spine" aria-hidden="true">
      <span class="book-splash__spine-rib"></span>
      <span class="book-splash__spine-rib"></span>
      <span class="book-splash__spine-rib"></span>
      <span class="book-splash__spine-rib"></span>
    </aside>

    <section class="book-splash__face" aria-labelledby="splash-title">
      <div class="book-splash__filigree" aria-hidden="true"></div>
      <header class="book-splash__header">
        <span>Personal Archive</span>
        <span>Vol. I · MMXXVI</span>
      </header>

      <div class="book-splash__center">
        <div class="book-splash__crest" aria-hidden="true">
          <svg viewBox="0 0 100 100" fill="none">
            <circle cx="50" cy="50" r="42" stroke="currentColor" opacity="0.52" />
            <path d="M29 39c8-11 15-15 21-15s13 4 21 15l-7 1c5 6 7 12 7 19 0 14-9 23-21 23s-21-9-21-23c0-7 2-13 7-19l-7-1Z" stroke="currentColor" stroke-width="1.5" />
            <circle cx="41" cy="51" r="6" stroke="currentColor" /><circle cx="59" cy="51" r="6" stroke="currentColor" />
            <circle cx="41" cy="51" r="2" fill="currentColor" /><circle cx="59" cy="51" r="2" fill="currentColor" />
            <path d="m50 55-5 6h10l-5-6ZM36 70l14-8 14 8M50 24v-8M27 27l-6-6M73 27l6-6" stroke="currentColor" />
          </svg>
        </div>
        <h1 class="book-splash__title" id="splash-title">itsdangerous</h1>
        <p class="book-splash__subtitle">기록과 작업, 취향과 놀이를 보관하는 한 권의 개인 장서</p>
      </div>

      <nav class="book-splash__chapters" aria-label="사이트 공간">
        <a href="/blog/">Blog</a>
        <a href="/portfolio/">Portfolio</a>
        <a href="/games/">Games</a>
        <a href="/about/">About</a>
      </nav>
    </section>
  </main>
</SplashLayout>
