---
import SiteLayout from '../../../shared/layouts/SiteLayout.astro';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
---

<SiteLayout title={title} description={description} canonicalPath={canonicalPath}>
  <slot />
</SiteLayout>
