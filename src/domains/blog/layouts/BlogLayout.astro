---
import SiteLayout from '../../../shared/layouts/SiteLayout.astro';
import '../styles/blog.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
---

<SiteLayout title={title} description={description} canonicalPath={canonicalPath}>
  <slot name="head" slot="head" />
  <slot />
  <slot name="body-end" slot="body-end" />
</SiteLayout>
