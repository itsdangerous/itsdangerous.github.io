---
import type { CollectionEntry } from 'astro:content';
import BlogLayout from './BlogLayout.astro';
import { getPostSlug } from '../content/post-slug';
import ArticleMeta from '../components/ArticleMeta.astro';
import CodeShellEnhancer from '../components/CodeShellEnhancer.astro';
import TableOfContents from '../components/TableOfContents.astro';
import GiscusComments from '../../../shared/components/GiscusComments.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'posts'>;
  headings: Heading[];
}

const { post, headings } = Astro.props;
const slug = getPostSlug(post);
const commentsCategory = import.meta.env.PUBLIC_GISCUS_COMMENTS_CATEGORY?.trim();
const commentsCategoryId = import.meta.env.PUBLIC_GISCUS_COMMENTS_CATEGORY_ID?.trim();
---

<BlogLayout
  title={`${post.data.title} — itsdangerous`}
  description={post.data.description}
  canonicalPath={`/blog/posts/${slug}/`}
>
  <main class="article-shell" data-toc-collapsed>
    <div class="article__toc-bar" data-toc-topbar>
      <button type="button" data-toc-top-toggle aria-expanded="false" aria-controls="article-toc-panel">
        <span aria-hidden="true">☷</span>
        <span>목차</span>
      </button>
    </div>
    <article class="article" data-pagefind-body>
      <header class="article__header">
        <ArticleMeta post={post} />
        <h1>{post.data.title}</h1>
        <p class="article__description">{post.data.description}</p>
      </header>

      <div class="article__mobile-toc">
        <TableOfContents headings={headings} />
      </div>

      <div class="article__content">
        <slot />
      </div>

      <section class="article__comments" aria-label="댓글">
        <GiscusComments
          mapping="pathname"
          category={commentsCategory}
          categoryId={commentsCategoryId}
        />
        <slot name="comments" />
      </section>
    </article>
    <aside id="article-toc-panel" class="article__desktop-toc" data-toc-collapsed>
      <TableOfContents headings={headings} />
    </aside>
  </main>
  <CodeShellEnhancer />
  <script>
    const initializeArticleTocBar = () => {
      const toggle = document.querySelector<HTMLButtonElement>('[data-toc-top-toggle]');
      const shell = toggle?.closest<HTMLElement>('.article-shell');
      const panel = document.querySelector<HTMLElement>('#article-toc-panel');

      if (!toggle || !shell || !panel || toggle.dataset.bound) return;
      toggle.addEventListener('click', () => {
        const open = shell.toggleAttribute('data-toc-top-open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      panel.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) {
          shell.removeAttribute('data-toc-top-open');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
      toggle.dataset.bound = 'true';
    };

    initializeArticleTocBar();
    document.addEventListener('astro:page-load', initializeArticleTocBar);
  </script>
</BlogLayout>
