---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const navigableHeadings = headings.filter(({ depth, slug, text }) => (
  depth >= 2 && depth <= 3 && slug.trim().length > 0 && text.trim().length > 0
));
const collapsedHeadings = navigableHeadings.filter(({ depth }) => depth === 2);
---

{navigableHeadings.length > 0 && (
  <>
    <nav id="article-toc" class="table-of-contents__desktop editorial-surface" aria-label="이 글의 목차">
      <ol>
        {navigableHeadings.map((heading) => (
          <li class:list={[`table-of-contents__item--depth-${heading.depth}`]}>
            <a data-toc-link href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
      <div class="table-of-contents__collapsed-preview" aria-hidden="true">
        {collapsedHeadings.map((heading) => <span data-toc-preview={heading.slug} />)}
      </div>
    </nav>
    <details class="table-of-contents__mobile editorial-surface">
      <summary>이 글의 목차</summary>
      <ol>
        {navigableHeadings.map((heading) => (
          <li class:list={[`table-of-contents__item--depth-${heading.depth}`]}>
            <a data-toc-link href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </details>
    <script>
      import { initializeTableOfContents } from './table-of-contents';
      initializeTableOfContents();
      document.addEventListener('astro:page-load', () => initializeTableOfContents());
    </script>
  </>
)}
