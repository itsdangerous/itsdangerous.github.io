<script>
  function showCopyToast() {
    let container = document.querySelector<HTMLElement>('.code-copy-toasts');

    if (!container) {
      container = document.createElement('div');
      container.className = 'code-copy-toasts';
      document.body.append(container);
    }

    const toast = document.createElement('div');
    toast.className = 'code-copy-toast';
    toast.setAttribute('role', 'status');

    const message = document.createElement('span');
    message.className = 'code-copy-toast__message';
    message.textContent = 'Copied to clipboard';

    const dismiss = document.createElement('button');
    dismiss.type = 'button';
    dismiss.className = 'code-copy-toast__dismiss';
    dismiss.setAttribute('aria-label', 'Dismiss copy confirmation');
    dismiss.textContent = '×';
    dismiss.addEventListener('click', () => toast.remove());

    toast.append(message, dismiss);
    container.prepend(toast);
  }

  async function copyCode(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.append(textarea);
      textarea.select();
      const copied = document.execCommand('copy');
      textarea.remove();
      return copied;
    }
  }

  function createCopyButton(pre: HTMLPreElement) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-shell__copy';
    button.setAttribute('aria-label', 'Copy code');
    button.setAttribute('data-tooltip', 'Copy code');
    button.innerHTML = `
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <rect x="9" y="9" width="11" height="11" rx="1.5"></rect>
        <path d="M15 9V5.5A1.5 1.5 0 0 0 13.5 4h-9A1.5 1.5 0 0 0 3 5.5v9A1.5 1.5 0 0 0 4.5 16H9"></path>
      </svg>
    `;

    button.addEventListener('click', async () => {
      if (!await copyCode(pre.textContent ?? '')) return;

      button.setAttribute('aria-label', 'Copied');
      button.setAttribute('data-tooltip', 'Copied');
      button.dataset.copied = 'true';
      showCopyToast();
      window.setTimeout(() => {
        button.setAttribute('aria-label', 'Copy code');
        button.setAttribute('data-tooltip', 'Copy code');
        delete button.dataset.copied;
      }, 1800);
    });

    return button;
  }

  function createHorizontalScrollbar(pre: HTMLPreElement, index: number) {
    if (!pre.id) pre.id = `code-shell-panel-${index + 1}`;

    const scrollbar = document.createElement('div');
    scrollbar.className = 'code-shell__scrollbar';
    scrollbar.hidden = true;

    const track = document.createElement('div');
    track.className = 'code-shell__scrollbar-track';

    const thumb = document.createElement('div');
    thumb.className = 'code-shell__scrollbar-thumb';
    thumb.tabIndex = 0;
    thumb.setAttribute('role', 'scrollbar');
    thumb.setAttribute('aria-label', '코드 가로 스크롤');
    thumb.setAttribute('aria-controls', pre.id);
    thumb.setAttribute('aria-orientation', 'horizontal');
    thumb.setAttribute('aria-valuemin', '0');
    thumb.setAttribute('aria-valuemax', '100');
    thumb.setAttribute('aria-valuenow', '0');

    track.append(thumb);
    scrollbar.append(track);

    let frame = 0;
    let maximumScroll = 0;
    let thumbTravel = 0;

    const update = () => {
      frame = 0;
      maximumScroll = Math.max(pre.scrollWidth - pre.clientWidth, 0);
      scrollbar.hidden = maximumScroll <= 1;

      if (scrollbar.hidden) {
        thumb.setAttribute('aria-valuenow', '0');
        return;
      }

      const trackWidth = track.clientWidth;
      const visibleRatio = Math.min(pre.clientWidth / pre.scrollWidth, 1);
      const thumbWidth = Math.min(trackWidth, Math.max(trackWidth * visibleRatio, 48));
      const progress = maximumScroll === 0 ? 0 : pre.scrollLeft / maximumScroll;

      thumbTravel = Math.max(trackWidth - thumbWidth, 0);
      thumb.style.width = `${thumbWidth}px`;
      thumb.style.transform = `translate3d(${thumbTravel * progress}px, -50%, 0)`;
      thumb.setAttribute('aria-valuenow', String(Math.round(progress * 100)));
    };

    const scheduleUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    const scrollByKeyboard = (event: KeyboardEvent) => {
      const lineStep = 48;
      const pageStep = pre.clientWidth * 0.8;
      let nextPosition: number | null = null;

      if (event.key === 'ArrowLeft') nextPosition = pre.scrollLeft - lineStep;
      if (event.key === 'ArrowRight') nextPosition = pre.scrollLeft + lineStep;
      if (event.key === 'PageUp') nextPosition = pre.scrollLeft - pageStep;
      if (event.key === 'PageDown') nextPosition = pre.scrollLeft + pageStep;
      if (event.key === 'Home') nextPosition = 0;
      if (event.key === 'End') nextPosition = maximumScroll;
      if (nextPosition === null) return;

      event.preventDefault();
      pre.scrollLeft = Math.max(0, Math.min(nextPosition, maximumScroll));
      scheduleUpdate();
    };

    thumb.addEventListener('keydown', scrollByKeyboard);

    thumb.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      const startX = event.clientX;
      const startScroll = pre.scrollLeft;
      thumb.setPointerCapture(event.pointerId);
      thumb.dataset.dragging = 'true';

      const move = (moveEvent: PointerEvent) => {
        if (!thumb.hasPointerCapture(moveEvent.pointerId) || thumbTravel === 0) return;
        const delta = moveEvent.clientX - startX;
        pre.scrollLeft = startScroll + (delta / thumbTravel) * maximumScroll;
      };

      const finish = (finishEvent: PointerEvent) => {
        if (thumb.hasPointerCapture(finishEvent.pointerId)) {
          thumb.releasePointerCapture(finishEvent.pointerId);
        }
        delete thumb.dataset.dragging;
        thumb.removeEventListener('pointermove', move);
        thumb.removeEventListener('pointerup', finish);
        thumb.removeEventListener('pointercancel', finish);
      };

      thumb.addEventListener('pointermove', move);
      thumb.addEventListener('pointerup', finish);
      thumb.addEventListener('pointercancel', finish);
    });

    track.addEventListener('pointerdown', (event) => {
      if (event.target === thumb || maximumScroll === 0 || thumbTravel === 0) return;

      const bounds = track.getBoundingClientRect();
      const thumbWidth = thumb.getBoundingClientRect().width;
      const nextThumbPosition = Math.max(
        0,
        Math.min(event.clientX - bounds.left - (thumbWidth / 2), thumbTravel),
      );
      pre.scrollLeft = (nextThumbPosition / thumbTravel) * maximumScroll;
    });

    pre.addEventListener('scroll', scheduleUpdate, { passive: true });
    const resizeObserver = new ResizeObserver(scheduleUpdate);
    resizeObserver.observe(pre);
    document.fonts?.ready.then(scheduleUpdate);
    window.addEventListener('load', scheduleUpdate, { once: true });
    window.requestAnimationFrame(update);

    return scrollbar;
  }

  document.querySelectorAll<HTMLPreElement>('.article__content pre').forEach((pre, index) => {
    if (pre.parentElement?.classList.contains('code-shell')) return;

    const shell = document.createElement('div');
    shell.className = 'code-shell';

    const header = document.createElement('div');
    header.className = 'code-shell__header';

    const marker = document.createElement('span');
    marker.className = 'code-shell__marker';
    marker.textContent = '>_';
    marker.setAttribute('aria-hidden', 'true');

    header.append(marker, createCopyButton(pre));
    pre.before(shell);
    shell.append(header, pre, createHorizontalScrollbar(pre, index));
    shell.classList.add('code-shell--custom-scrollbar');
  });
</script>
