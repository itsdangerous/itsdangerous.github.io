---
import type { CollectionEntry } from 'astro:content';
import { getPostSlug } from '../content/post-slug';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const slug = getPostSlug(post);
const { category, description, pubDate, title } = post.data;
const date = [pubDate.getFullYear(), String(pubDate.getMonth() + 1).padStart(2, '0'), String(pubDate.getDate()).padStart(2, '0')].join('.');
const categoryHref = `/blog/categories/${encodeURIComponent(category)}/`;
---

<li class="post-card">
  <article>
    <div class="post-card__meta">
      <a href={categoryHref}>{category}</a>
      <span aria-hidden="true">·</span>
      <time datetime={pubDate.toISOString()}>{date}</time>
    </div>
    <div class="post-card__copy">
      <h3><a href={`/blog/posts/${slug}/`}>{title}</a></h3>
      <p>{description}</p>
    </div>
  </article>
</li>
