---
import '../styles/comments.css';
import '../../domains/blog/styles/editorial-surfaces.css';
interface Props { page: string; guestbook?: boolean }
const { page, guestbook = false } = Astro.props;
const api = import.meta.env.PUBLIC_COMMENTS_API_URL?.trim() || 'https://itsdangerous-admin.tmdrbsla123.workers.dev';
---
<section class="comments" data-comments data-api={api} data-page={page} data-pagefind-ignore aria-label={guestbook ? '방명록 남기기' : '댓글'}>
  <div class="comments-heading">
    <div><p class="comments-eyebrow">{guestbook ? 'GUESTBOOK' : 'MARGINALIA'}</p><h2>{guestbook ? '다녀간 자리' : '댓글'} <span data-count></span></h2></div>
  </div>
  <p class="comments-intro">{guestbook ? '안부도, 짧은 인사도 반갑습니다.' : '읽으며 떠오른 생각을 남겨주세요.'} 로그인 없이 쓸 수 있습니다.</p>
  <div class="comments-list-heading"><span>남겨진 이야기 <span data-total></span></span><button type="button" data-reload>새로고침</button></div>
  <p class="comment-status" data-list-status role="status" aria-live="polite">댓글을 불러오고 있습니다.</p>
  <div data-list></div>
  <button type="button" class="comment-more" data-more hidden>댓글 더 보기</button>
  <form class="comment-compose editorial-surface" data-compose>
    <div class="comment-fields">
      <label>닉네임<input name="nickname" required maxlength="30" autocomplete="nickname" placeholder="어떤 이름으로 남길까요" /></label>
      <label>비밀번호<input name="password" type="password" required minlength="4" maxlength="128" autocomplete="new-password" placeholder="4자 이상" /></label>
    </div>
    <fieldset class="comment-visibility"><legend>공개 범위</legend><label><input name="visibility" type="radio" value="public" checked /> 공개 <span>누구나 내용을 볼 수 있습니다.</span></label><label><input name="visibility" type="radio" value="private" /> 비공개 <span>비밀번호를 아는 사람만 볼 수 있습니다.</span></label></fieldset>
    <label class="comment-body-label">{guestbook ? '남길 말' : '댓글'}<textarea name="body" required maxlength="3000" rows="4" placeholder={guestbook ? '이곳에 인사를 남겨주세요.' : '덧붙이고 싶은 이야기, 궁금한 점이 있나요?'}></textarea></label>
    <label class="comment-honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
    <div class="comment-compose-footer"><button class="comment-submit" type="submit">{guestbook ? '인사 남기기' : '댓글 남기기'} <span aria-hidden="true">↗</span></button></div>
    <p class="comment-status" data-compose-status role="status" aria-live="polite"></p>
  </form>
  <noscript>댓글을 보거나 작성하려면 JavaScript를 켜주세요.</noscript>
</section>
<script>
  import { initializeComments } from '../scripts/comments';
  initializeComments();
  document.addEventListener('astro:page-load', initializeComments);
</script>
