<div class="feature-bundle" data-feature-bundle>
  <button
    class="feature-bundle__toggle"
    type="button"
    aria-expanded="false"
    aria-controls="feature-bundle-panel"
    aria-label="기능 꾸러미 열기"
    title="클릭하여 열기 · 드래그하여 이동"
    data-feature-toggle
  >
    <span aria-hidden="true">✦</span>
  </button>
  <div class="feature-bundle__panel" id="feature-bundle-panel" data-feature-panel hidden>
    <p class="feature-bundle__message">To be Continue</p>
  </div>
</div>

<button type="button" class="focus-mode-exit" data-focus-exit aria-label="집중 보기 종료" title="집중 보기 종료">
  <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <path d="M11 5H6a1 1 0 0 0-1 1v5m16-6h5a1 1 0 0 1 1 1v5M5 21v5a1 1 0 0 0 1 1h5m10 0h5a1 1 0 0 0 1-1v-5M12 12h8m-8 4h8m-8 4h5" />
  </svg>
</button>

<p class="focus-mode-notice" role="status" aria-live="polite" data-focus-notice hidden></p>

<script>
  const bundle = document.querySelector<HTMLElement>('[data-feature-bundle]');
  const toggle = bundle?.querySelector<HTMLButtonElement>('[data-feature-toggle]');
  const panel = bundle?.querySelector<HTMLElement>('[data-feature-panel]');

  if (bundle && toggle && panel && !toggle.dataset.bound) {
    let isOpen = false;
    const focusButton = document.querySelector<HTMLButtonElement>('[data-focus-mode]');
    const focusExit = document.querySelector<HTMLButtonElement>('[data-focus-exit]');
    const notice = document.querySelector<HTMLElement>('[data-focus-notice]');
    let focusAnimation: Animation | undefined;
    let noticeAnimation: Animation | undefined;
    const setFocusMode = (enabled: boolean) => {
      document.documentElement.toggleAttribute('data-focus-mode', enabled);
      focusButton?.setAttribute('aria-pressed', String(enabled));
      const label = enabled ? '집중 보기 종료 (Esc)' : '집중해서 보기';
      focusButton?.setAttribute('aria-label', label);
      const focusHint = focusButton?.querySelector('.site-header__control-hint');
      if (focusHint) focusHint.textContent = label;
      setOpen(false);
      toggle.focus({ preventScroll: true });
      window.dispatchEvent(new Event('resize'));
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      focusAnimation?.cancel();
      const content = document.querySelector<HTMLElement>('.site-content');
      focusAnimation = content?.animate([
        { opacity: 0.25, transform: reduced ? 'none' : 'translateY(8px)' },
        { opacity: 1, transform: 'none' },
      ], { duration: reduced ? 150 : 520, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
      if (notice) {
        noticeAnimation?.cancel();
        notice.hidden = false;
        notice.textContent = enabled ? '집중해서 보기 · Esc로 돌아가기' : '기본 보기로 돌아왔습니다';
        noticeAnimation = notice.animate([
          { opacity: 0, transform: reduced ? 'none' : 'translateY(-6px)', offset: 0 },
          { opacity: 1, transform: 'none', offset: 0.15 },
          { opacity: 1, transform: 'none', offset: 0.8 },
          { opacity: 0, transform: 'none', offset: 1 },
        ], { duration: 1800, easing: 'ease-out' });
        noticeAnimation.onfinish = () => { notice.hidden = true; };
      }
    };
    focusButton?.addEventListener('click', () => {
      setFocusMode(!document.documentElement.hasAttribute('data-focus-mode'));
    });
    focusExit?.addEventListener('click', () => setFocusMode(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && document.documentElement.hasAttribute('data-focus-mode')) {
        setFocusMode(false);
      }
    });
    let animation: Animation | undefined;
    let dragged = false;
    let drag: { id: number; x: number; y: number; left: number; top: number } | undefined;
    const inset = 12;
    const placePanel = () => {
      if (panel.hidden) return;
      const rect = bundle.getBoundingClientRect();
      const leftward = rect.left >= panel.offsetWidth + inset + 8 || rect.left > innerWidth / 2;
      bundle.dataset.rollout = leftward ? 'left' : 'right';
      panel.style.left = leftward ? `${-panel.offsetWidth - 8}px` : `${rect.width + 8}px`;
      panel.style.top = `${(rect.height - panel.offsetHeight) / 2}px`;
      panel.style.bottom = 'auto';
      panel.style.transformOrigin = leftward ? 'right center' : 'left center';
    };
    const moveTo = (left: number, top: number) => {
      bundle.style.right = 'auto';
      bundle.style.bottom = 'auto';
      bundle.style.left = `${Math.max(inset, Math.min(left, innerWidth - bundle.offsetWidth - inset))}px`;
      bundle.style.top = `${Math.max(inset, Math.min(top, innerHeight - bundle.offsetHeight - inset))}px`;
      placePanel();
    };
    const setOpen = (open: boolean) => {
      isOpen = open;
      animation?.cancel();
      bundle.toggleAttribute('data-open', open);
      panel.hidden = false;
      panel.inert = false;
      placePanel();
      bundle.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '기능 꾸러미 닫기' : '기능 꾸러미 열기');
      const leftward = bundle.dataset.rollout === 'left';
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const folded = { clipPath: leftward ? 'inset(0 0 0 100%)' : 'inset(0 100% 0 0)' };
      const unfolded = { clipPath: 'inset(0 0 0 0)' };
      const openingFrames = reducedMotion ? [
        { ...folded, transform: 'translateX(0)', offset: 0 },
        { ...unfolded, transform: `translateX(${leftward ? -6 : 6}px)`, offset: 0.7 },
        { ...unfolded, transform: 'translateX(0)', offset: 1 },
      ] : [
        { ...folded, transform: 'translateX(0)', offset: 0, easing: 'cubic-bezier(0.2, 0, 0.2, 1)' },
        { ...unfolded, transform: `translateX(${leftward ? -14 : 14}px)`, offset: 0.62, easing: 'cubic-bezier(0.7, 0, 1, 1)' },
        { ...unfolded, transform: `translateX(${leftward ? 3 : -3}px)`, offset: 0.83, easing: 'ease-out' },
        { ...unfolded, transform: 'translateX(0)', offset: 1 },
      ];
      animation = panel.animate(open ? openingFrames : [unfolded, folded], {
        duration: reducedMotion ? 260 : open ? 720 : 240,
        easing: open && !reducedMotion ? 'linear' : 'cubic-bezier(0.4, 0, 0.2, 1)',
      });
      animation.onfinish = () => { panel.hidden = !isOpen; };
    };

    toggle.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary || event.button !== 0) return;
      const rect = bundle.getBoundingClientRect();
      dragged = false;
      drag = { id: event.pointerId, x: event.clientX, y: event.clientY, left: rect.left, top: rect.top };
      toggle.setPointerCapture(event.pointerId);
    });
    toggle.addEventListener('pointermove', (event) => {
      if (!drag || drag.id !== event.pointerId) return;
      const dx = event.clientX - drag.x;
      const dy = event.clientY - drag.y;
      if (!dragged && Math.hypot(dx, dy) < 6) return;
      dragged = true;
      bundle.setAttribute('data-dragging', '');
      moveTo(drag.left + dx, drag.top + dy);
    });
    const endDrag = () => {
      drag = undefined;
      bundle.removeAttribute('data-dragging');
    };
    toggle.addEventListener('pointerup', endDrag);
    toggle.addEventListener('pointercancel', endDrag);
    toggle.addEventListener('lostpointercapture', endDrag);
    toggle.addEventListener('click', (event) => {
      if (dragged && event.detail !== 0) { dragged = false; return; }
      setOpen(!isOpen);
    });
    bundle.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen) { setOpen(false); toggle.focus(); }
    });
    window.addEventListener('resize', () => {
      if (bundle.style.left) {
        const rect = bundle.getBoundingClientRect();
        moveTo(rect.left, rect.top);
      } else placePanel();
    });
    document.addEventListener('click', (event) => {
      if (isOpen && !bundle.contains(event.target as Node)) {
        setOpen(false);
      }
    });
    toggle.dataset.bound = 'true';
  }
</script>
