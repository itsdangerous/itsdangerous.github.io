<div class="search-modal" data-search-modal hidden data-pagefind-ignore>
  <button class="search-modal__backdrop" type="button" data-search-close aria-label="검색 닫기"></button>
  <section class="search-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="search-modal-title">
    <header class="search-modal__header">
      <div>
        <p class="eyebrow">Search</p>
        <h2 id="search-modal-title">무엇을 찾고 있나요?</h2>
      </div>
      <button class="search-modal__close" type="button" data-search-close aria-label="검색 닫기">Esc</button>
    </header>
    <div class="search-modal__body">
      <div id="pagefind-search-modal" class="pagefind-ui"></div>
    </div>
  </section>
</div>

<script>
  const modal = document.querySelector<HTMLElement>('[data-search-modal]');
  const openButtons = document.querySelectorAll<HTMLElement>('[data-search-open]');
  const closeButtons = document.querySelectorAll<HTMLElement>('[data-search-close]');
  const homeSearchResults = document.querySelector<HTMLElement>('[data-home-search-results]');
  const homeSearchInput = document.querySelector<HTMLInputElement>('[data-home-search-input]');
  const homeSearchForm = document.querySelector<HTMLFormElement>('[data-home-search-form]');
  let initialized = false;
  let homeInitialized = false;
  let homePagefind: { triggerSearch: (term: string) => void } | undefined;
  let modalPagefind: { triggerSearch: (term: string) => void } | undefined;

  const macPlatform = /Mac|iPhone|iPad|iPod/i.test(navigator.platform || navigator.userAgent);
  document.querySelectorAll<HTMLElement>('.home-search__shortcut-key').forEach((key) => {
    key.textContent = macPlatform ? '⌘' : 'Ctrl';
  });

  const initializeHomeSearch = async () => {
    if (!homeSearchResults || homeInitialized) return;
    homeInitialized = true;
    try {
      const { PagefindUI } = await import('@pagefind/default-ui');
      homePagefind = new PagefindUI({
        element: '#pagefind-search-home',
        showImages: false,
      });
    } catch {
      homeSearchResults.textContent = '검색 색인은 배포 후 사용할 수 있습니다.';
    }
  };

  const searchFromHome = async () => {
    const term = homeSearchInput?.value.trim() ?? '';
    if (!homeSearchResults) return;
    homeSearchResults.hidden = !term;
    if (!term) return;
    await initializeHomeSearch();
    const latestTerm = homeSearchInput?.value.trim() ?? '';
    homeSearchResults.hidden = !latestTerm;
    if (latestTerm) homePagefind?.triggerSearch(latestTerm);
  };

  homeSearchInput?.addEventListener('input', () => { void searchFromHome(); });
  homeSearchForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const term = homeSearchInput?.value.trim() ?? '';
    if (term) void openSearch(term);
  });

  const openSearch = async (initialTerm: unknown = '') => {
    if (!modal) return;
    const searchTerm = typeof initialTerm === 'string' ? initialTerm : '';
    modal.hidden = false;
    document.body.classList.add('search-modal-open');
    if (!initialized) {
      initialized = true;
      try {
        const { PagefindUI } = await import('@pagefind/default-ui');
        modalPagefind = new PagefindUI({ element: '#pagefind-search-modal', showImages: false });
      } catch {
        const container = document.querySelector('#pagefind-search-modal');
        if (container) container.textContent = '검색 색인은 배포 후 사용할 수 있습니다.';
      }
    }
    window.setTimeout(() => {
      const modalInput = document.querySelector<HTMLInputElement>('.search-modal .pagefind-ui__search-input');
      if (modalInput && searchTerm) {
        modalInput.value = searchTerm;
        modalPagefind?.triggerSearch(searchTerm);
      }
      modalInput?.focus();
    }, 80);
  };

  const closeSearch = () => {
    if (!modal) return;
    modal.hidden = true;
    document.body.classList.remove('search-modal-open');
  };

  openButtons.forEach((button) => button.addEventListener('click', () => { void openSearch(); }));
  closeButtons.forEach((button) => button.addEventListener('click', closeSearch));
  window.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openSearch();
    }
    if (event.key === 'Escape' && modal && !modal.hidden) closeSearch();
  });
</script>

<style is:global>
  body.search-modal-open { overflow: hidden; }
  .search-modal[hidden] { display: none; }
  .search-modal { --pagefind-ui-scale: 1; --pagefind-ui-primary: var(--color-accent); --pagefind-ui-text: var(--color-text); --pagefind-ui-background: var(--color-surface); --pagefind-ui-border: var(--color-border); --pagefind-ui-tag: var(--color-surface-raised); --search-modal-top-padding: clamp(5rem, 16vh, 9rem); position: fixed; inset: 0; z-index: 100; display: grid; place-items: start center; padding: var(--search-modal-top-padding) 1rem 2rem; }
  .search-modal__backdrop { position: absolute; inset: 0; border: 0; background: color-mix(in srgb, var(--color-background) 78%, transparent); backdrop-filter: blur(12px); cursor: default; }
  .search-modal__dialog { position: relative; display: flex; width: min(680px, 100%); max-height: calc(100dvh - var(--search-modal-top-padding) - 2rem); min-height: 0; flex-direction: column; overflow: hidden; border: 1px solid var(--color-border); border-radius: 18px; background: var(--color-surface); box-shadow: 0 24px 80px rgb(0 0 0 / 35%); }
  .search-modal__header { display: flex; align-items: start; justify-content: space-between; gap: 1rem; padding: 1.25rem 1.35rem 1rem; border-bottom: 1px solid var(--color-border); }
  .search-modal__header .eyebrow { margin: 0 0 .3rem; }
  .search-modal__header h2 { margin: 0; font-size: 1.15rem; }
  .search-modal__close { border: 1px solid var(--color-border); border-radius: 7px; padding: .25rem .5rem; color: var(--color-text-muted); background: var(--color-surface-raised); font: inherit; font-size: .75rem; cursor: pointer; }
  .search-modal__body { min-height: 0; padding: 1rem 1.35rem 1.2rem; overflow-y: auto; overscroll-behavior: contain; }
  .search-modal .pagefind-ui { color: var(--color-text); }
  .search-modal .pagefind-ui .pagefind-ui__form { position: relative; }
  .search-modal .pagefind-ui .pagefind-ui__form::before {
    top: 1.32rem;
    left: 1.1rem;
    width: 1.1rem;
    height: 1.1rem;
    background-color: var(--color-text-muted);
  }
  .search-modal .pagefind-ui .pagefind-ui__search-input {
    width: 100%;
    min-height: 3.75rem;
    padding: 0 3.4rem 0 3.4rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-surface) 80%, transparent);
    box-shadow: 0 .8rem 2.5rem color-mix(in srgb, var(--color-background) 70%, transparent);
    font: .95rem var(--font-ui);
    font-weight: 400;
    outline: 0;
    transition: border-color 160ms ease, color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }
  .search-modal .pagefind-ui .pagefind-ui__search-input::placeholder { color: var(--color-text-muted); opacity: 1; }
  .search-modal .pagefind-ui .pagefind-ui__search-input:focus,
  .search-modal .pagefind-ui .pagefind-ui__form:focus-within .pagefind-ui__search-input {
    border-color: var(--color-accent);
    color: var(--color-text);
    box-shadow: 0 .9rem 2.8rem color-mix(in srgb, var(--color-accent) 15%, transparent);
    transform: translateY(-2px);
  }
  .search-modal .pagefind-ui .pagefind-ui__search-clear {
    position: absolute;
    top: .875rem;
    right: .8rem;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: var(--color-text-muted);
    background: transparent;
    font-size: 0;
  }
  .search-modal .pagefind-ui .pagefind-ui__search-clear::before {
    content: '×';
    font: 1.2rem/2rem var(--font-ui);
  }
  .search-modal .pagefind-ui .pagefind-ui__search-clear:hover,
  .search-modal .pagefind-ui .pagefind-ui__search-clear:focus-visible {
    color: var(--color-accent);
  }
</style>
