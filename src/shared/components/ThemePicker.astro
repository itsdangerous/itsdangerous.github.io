<button type="button" role="switch" aria-label="라이트 테마로 전환" aria-checked="false" data-theme-toggle>
  <span class="sr-only">테마 변경</span>
  <img data-theme-icon="sun" src="/images/theme-sun.png" alt="" width="28" height="28" />
  <img data-theme-icon="moon" src="/images/theme-moon-dark.png" alt="" width="28" height="28" />
</button>

<script>
  import { applyTheme, THEME_STORAGE_KEY } from '../scripts/theme-init';
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const sync = () => {
    const isLight = document.documentElement.dataset.theme === 'light';
    if (toggle) {
      toggle.setAttribute('aria-checked', String(isLight));
      toggle.setAttribute('aria-label', isLight ? '다크 테마로 전환' : '라이트 테마로 전환');
    }
  };
  if (toggle) {
    sync();
    toggle.addEventListener('click', () => {
      const theme = applyTheme(document.documentElement.dataset.theme === 'light' ? 'midnight' : 'light');
      try {
        localStorage.setItem(THEME_STORAGE_KEY, theme.id);
      } catch {
        // Continue the current session when storage is unavailable.
      }
      window.dispatchEvent(new CustomEvent('themechange', { detail: theme }));
      sync();
    });
  }
</script>
