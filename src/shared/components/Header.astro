---
import SearchButton from './SearchButton.astro';

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => href === '/blog/'
  ? pathname === '/blog/'
  : href === '/blog/posts/'
    ? pathname === '/blog/posts/' || pathname.startsWith('/blog/posts/')
    : pathname === href || pathname.startsWith(href);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="itsdangerous 홈">
      <img
        src="/images/splash-title-embroidered.webp"
        alt="itsdangerous"
        class="site-header__brand-image"
        width="1095"
        height="250"
        loading="eager"
        decoding="async"
      />
    </a>
    <nav aria-label="주요 메뉴">
      <a href="/blog/" class:list={{ 'is-current': isCurrent('/blog/') }}><span>Home</span></a>
      <a href="/blog/posts/" class:list={{ 'is-current': isCurrent('/blog/posts/') }}><span>Posts</span></a>
      <a href="/blog/categories/" class:list={{ 'is-current': isCurrent('/blog/categories/') }}><span>Categories</span></a>
      <a href="/guestbook/" class:list={{ 'is-current': isCurrent('/guestbook/') }}><span>Guestbook</span></a>
      <SearchButton variant="navigation" />
    </nav>
    <p class="site-header__stats">29 posts · 7 categories</p>
  </div>
</header>

<script>
  const initializeHeaderVisibility = () => {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header || header.dataset.scrollBound) return;

    let previousY = window.scrollY;
    const navbarMode = window.matchMedia('(max-width: 900px)');
    const syncHeaderMode = () => {
      if (!navbarMode.matches) header.removeAttribute('data-scroll-hidden');
    };

    syncHeaderMode();
    navbarMode.addEventListener('change', syncHeaderMode);
    window.addEventListener('scroll', () => {
      const currentY = window.scrollY;
      if (!navbarMode.matches) {
        header.removeAttribute('data-scroll-hidden');
        previousY = currentY;
        return;
      }
      const delta = currentY - previousY;
      if (currentY <= 12) header.removeAttribute('data-scroll-hidden');
      else if (delta > 6) header.setAttribute('data-scroll-hidden', 'true');
      else if (delta < -6) header.removeAttribute('data-scroll-hidden');
      previousY = currentY;
    }, { passive: true });
    header.dataset.scrollBound = 'true';
  };

  initializeHeaderVisibility();
  document.addEventListener('astro:page-load', initializeHeaderVisibility);
</script>
