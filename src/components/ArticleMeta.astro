---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { category, pubDate, tags } = post.data;
const date = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Seoul',
}).format(pubDate);
---

<div class="article-meta">
  <div class="article-meta__primary">
    <a href={`/categories/${encodeURIComponent(category)}/`}>{category}</a>
    <time datetime={pubDate.toISOString()}>{date}</time>
  </div>
  {tags.length > 0 && (
    <ul class="article-meta__tags" aria-label="태그">
      {tags.map((tag) => <li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>)}
    </ul>
  )}
</div>
